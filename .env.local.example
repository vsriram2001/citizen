# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (shared by every worktree — one database for all chats)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (vote action)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# LLM gateway (lib/llm.ts) — suggest / resolve / feasibility
TRUEFOUNDRY_API_KEY=
TRUEFOUNDRY_BASE_URL=

# Web search grounding (lib/web-search.ts)
TAVILY_API_KEY=

# Optional: absolute site URL for share links / OG images (lib/site-url.ts)
NEXT_PUBLIC_SITE_URL=
# Optional: override the gateway models (defaults: claude-opus-5-5 / claude-haiku-5-5)
# LLM_MODEL=
# LLM_FAST_MODEL=

# Bearer secret for the nightly thought-digest job (api/cron/digest-thoughts)
CRON_SECRET=
